{
  "name": "@protege/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepare-kokoro": "node scripts/prepare-kokoro.mjs",
    "seed:echo": "tsx --env-file=.env scripts/seed-echo.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@hono/node-server": "^1.13.0",
    "@protege/types": "workspace:*",
    "@supabase/supabase-js": "^2.103.0",
    "hono": "^4.6.0",
    "kokoro-js": "^1.2.0",
    "openai": "^6.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
