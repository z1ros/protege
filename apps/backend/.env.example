PORT=8787

# Auth — gate /echo/*, /classify, /verify, /me, /memory, /preferences,
# /concept-used behind GitHub Bearer-token verification. The backend
# requires every request to those routes to present a valid GitHub Bearer
# token (the extension's authHeaders() helper sends one automatically
# after sign-in) and rejects any request whose claimed userId
# (body/header/query) doesn't match the verified GitHub numeric id.
#
# Default ON. Set to "false" or "0" ONLY for local single-user dev — any
# hosted or multi-user deployment must keep this on.
PROTEGE_AUTH_REQUIRED=true
# PROTEGE_AUTH_REQUIRED=false

# Anthropic (primary — chat, analyze, concepts)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional per-tier overrides
# ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
# ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6

# OpenAI (STT via Whisper; optional chat fallback)
OPENAI_API_KEY=sk-...
# Premium tier — used for user-triggered chat, Learning Mode, voice Explain.
OPENAI_MODEL=gpt-4.1
# Cheap tier — used for auto-fired background scans (file-open greeter,
# vibeBrief, struggleChip, patternSpotter, ownershipInviter, inline error
# explanations). About 5× cheaper input, 5× cheaper output. Override here
# if you want to A/B a different cheap model.
OPENAI_CHEAP_MODEL=gpt-4.1-mini

# Supabase — optional but required for cross-device durability.
# Without these, Echo data only lives in .protege-store.json and is lost on cache wipe.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=...
# Server-side only. Bypasses RLS for backend dual-writes. Never expose to client.
SUPABASE_SERVICE_KEY=...
# Direct Postgres URL — used only by scripts/run-seed.ts for raw DDL.
# Optional in normal runtime. NEVER commit the password; keep it in .env only.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Kokoro TTS (optional; defaults shown)
# KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
# KOKORO_DTYPE=fp16
# KOKORO_VOICE_FEMALE=af_bella
# KOKORO_VOICE_MALE=am_michael
