# Local dev port. Railway injects PORT automatically — do NOT set it there.
PORT=8787

NODE_ENV=development

# Auth — gate /echo/*, /classify, /verify, /me, /memory, /preferences,
# /concept-used behind GitHub Bearer-token verification. The backend
# requires every request to those routes to present a valid GitHub Bearer
# token (the extension's authHeaders() helper sends one automatically
# after sign-in) and rejects any request whose claimed userId
# (body/header/query) doesn't match the verified GitHub numeric id.
#
# Default ON. Set to "false" or "0" ONLY for local single-user dev — any
# hosted or multi-user deployment must keep this on.
PROTEGE_AUTH_REQUIRED=true
# PROTEGE_AUTH_REQUIRED=false

# Disable the dev-user shortcut in production.
PROTEGE_ALLOW_DEV_USER=false

# Quota enforcement. Default true. Set false only for unrestricted dev.
PROTEGE_QUOTAS=true

# CORS — comma-separated origin allowlist. Leave empty to allow all
# origins (current default; auth middleware is the real gate).
# Example: PROTEGE_CORS_ORIGINS=https://vscode.dev,vscode-webview://*
# PROTEGE_CORS_ORIGINS=

# Anthropic (primary — chat, analyze, concepts)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional per-tier overrides
# ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
# ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6

# OpenAI (STT via Whisper; optional chat fallback)
OPENAI_API_KEY=sk-...
# Premium tier — used for user-triggered chat, Learning Mode, voice Explain.
OPENAI_MODEL=gpt-4.1
# Cheap tier — used for auto-fired background scans (file-open greeter,
# vibeBrief, struggleChip, patternSpotter, ownershipInviter, inline error
# explanations). About 5× cheaper input, 5× cheaper output. Override here
# if you want to A/B a different cheap model.
OPENAI_CHEAP_MODEL=gpt-4.1-mini

# Provider routing override. Leave unset for default behavior.
# AI_PROVIDER=anthropic

# Supabase — required in any hosted/multi-user deployment.
# Without these, Echo data only lives in .protege-store.json (ephemeral on Railway).
SUPABASE_URL=https://xxxx.supabase.co
# Server-side only. Bypasses RLS for backend dual-writes. Never expose to client.
SUPABASE_SERVICE_KEY=...
# Optional: anon key. SERVICE_KEY alone is sufficient at runtime; ANON_KEY is
# only used as a fallback if SERVICE_KEY is missing.
# SUPABASE_ANON_KEY=...

# Prisma — Postgres connection strings. On Supabase:
#   DATABASE_URL = pooled (Transaction mode, port 6543)
#                  e.g. postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct (Session mode, port 5432) — required for migrations
#                  e.g. postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# A single-tier setup (DATABASE_URL = DIRECT_URL = direct connection) also
# works for low-concurrency deployments.
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Optional — used only by scripts/run-seed.ts for raw DDL during local seeds.
# Same value as DIRECT_URL.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Kokoro TTS (optional; defaults shown)
# KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
# KOKORO_DTYPE=fp16
# KOKORO_VOICE_FEMALE=af_bella
# KOKORO_VOICE_MALE=am_michael
