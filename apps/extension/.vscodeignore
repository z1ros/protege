# Files to exclude from the .vsix package.
# Anything not explicitly excluded here ends up in the marketplace upload —
# including node_modules and your .env, so this file matters.

# Source — only the bundled `dist/` ships
src/**
webview/**
**/*.ts
**/*.tsx
**/*.map
tsconfig*.json
tsup.config.ts
vite.config.mts
vitest.config.ts

# Dev dependencies — `dist/` already inlines what's needed at runtime
node_modules/**

# Vendored runtime packages — `.vendor/` is populated by
# `scripts/vendor-llama.mjs` before packaging. It contains a flat copy
# of `node-llama-cpp/` (without its 28 MB C++ source folder, just the
# JS runtime + bins manifest) so the extension can load it without
# needing `node_modules/` to be present at runtime. WHITELIST it: the
# blanket `node_modules/**` and `**/*.ts` patterns above would
# otherwise strip parts of the vendor tree.
!.vendor/**

# Tests
**/*.test.ts
**/*.test.tsx

# Local config / secrets — must NOT ship
.env
.env.*
.vscode/**
.vscode-test/**
.git/**
.gitignore
.eslintrc*
.prettierrc*

# Editor cruft
.DS_Store
**/.DS_Store
*.log

# Build artifacts that aren't `dist/`
.turbo/**
.cache/**
.next/**
coverage/**

# Native Rust source for protege-mic — fetchAssets.ts pulls the
# pre-built binary from a GitHub Release at first voice-mode use, so
# neither the source nor the binary ships in the .vsix. Keeping native/
# in the package would balloon it past the 50 MB marketplace cap (the
# Cargo `target/` dir alone is ~1.1 GB).
native/**

# Wake-word binary + ONNX models are NOT bundled into the .vsix.
# fetchAssets.ts downloads the platform-specific tarball from a GitHub
# Release on first voice-mode click. This keeps the .vsix lean (well
# under the 50 MB cap), avoids macOS quarantine on the binary (Node's
# fetch doesn't tag downloads with com.apple.quarantine), and means a
# new platform binary doesn't require re-publishing the marketplace
# extension.
bin/**
models/**

# Tarballs produced by scripts/package-voice-assets.sh are publish
# artifacts, not extension files.
release-artifacts/**

# Tmp dir fetchAssets.ts uses during install.
.voice-tmp/**

# On-device model cache — the runtime downloads Qwen 7B GGUF (~4.7 GB)
# into globalStorage at first use. A stray `.model-cache/` at the
# extension root (from local testing or legacy paths) must NEVER be
# packaged: it bloats the .vsix to 5+ GB AND chokes vsce's >2 GB secret
# scanner. Marketplace also has a hard 50 MB upload limit.
.model-cache/**
**/.model-cache/**
*.gguf
*.onnx.cache

# Echo + extension dev ledgers / scratch artifacts that don't belong in
# the package (~/.claude session files, SQLite ledgers, telemetry caches).
.lesson-sessions.json
.protege-*
echo.db*
**/.cache/**

# Web-extension manifests we don't ship
.vscode-web/**

# OS / IDE noise
Thumbs.db
