{
  "name": "@protege/extension",
  "displayName": "Protege",
  "description": "AI coding mentor that lives in your editor",
  "version": "0.0.1",
  "private": true,
  "publisher": "protege",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "protege",
          "title": "Protege",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "protege": [
        {
          "type": "webview",
          "id": "protege.launcher",
          "name": "Protege"
        }
      ]
    },
    "commands": [
      {
        "command": "protege.openInNewTab",
        "title": "Protege: Open in New Tab"
      },
      {
        "command": "protege.toggle",
        "title": "Protege: Toggle"
      },
      {
        "command": "protege.diagnose",
        "title": "Protege: Diagnose (list available commands)"
      }
    ],
    "keybindings": [
      {
        "command": "protege.toggle",
        "key": "cmd+shift+l",
        "when": "!terminalFocus"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && vite build",
    "build:ext": "tsup",
    "build:webview": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@protege/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
