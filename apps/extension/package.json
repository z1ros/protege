{
  "name": "@protege/extension",
  "displayName": "Protege",
  "description": "AI coding mentor that lives in your editor",
  "version": "0.0.1",
  "private": true,
  "publisher": "protege",
  "engines": {
    "vscode": "^1.90.0"
  },
  "enabledApiProposals": [
    "editorInsets"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "protege",
          "title": "Protege",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "protege": [
        {
          "type": "webview",
          "id": "protege.launcher",
          "name": "Protege"
        }
      ]
    },
    "commands": [
      {
        "command": "protege.openInNewTab",
        "title": "Protege: Open in New Tab"
      },
      {
        "command": "protege.enableInlineCards",
        "title": "Protege: Enable Inline Cards (inset setup)"
      },
      {
        "command": "protege.toggleAutoAcceptEdits",
        "title": "Protege: Toggle Auto-Accept AI Edits"
      },
      {
        "command": "protege.testOnDevice",
        "title": "Protege: Test On-Device Model"
      },
      {
        "command": "protege.showLogs",
        "title": "Protege: Show Logs"
      },
      {
        "command": "protege.toggleVoiceExplain",
        "title": "Protege: Cycle Explain Mode (text → voice → both)"
      },
      {
        "command": "protege.calibrateWakeWord",
        "title": "Protege: Calibrate Wake Word (personalize detection)"
      },
      {
        "command": "protege.restartWakeListener",
        "title": "Protege: Restart Wake Word Listener"
      },
      {
        "command": "protege.toggle",
        "title": "Protege: Toggle"
      },
      {
        "command": "protege.toggleWake",
        "title": "Protege: Toggle Wake Word"
      },
      {
        "command": "protege.teachThis",
        "title": "Protege: Teach this"
      },
      {
        "command": "protege.teachConcept",
        "title": "Protege: Teach concept"
      },
      {
        "command": "protege.explainSelection",
        "title": "Protege: Explain selection"
      },
      {
        "command": "protege.summarizeFile",
        "title": "Protege: What does this file do?"
      },
      {
        "command": "protege.greetCurrentFile",
        "title": "Protege: Replay file greeting"
      },
      {
        "command": "protege.playCurrentFileOverview",
        "title": "Protege: Play overview of current file"
      },
      {
        "command": "protege.weakSpots",
        "title": "Protege: Show my weak spots"
      },
      {
        "command": "protege.quizMe",
        "title": "Protege: Quiz me"
      },
      {
        "command": "protege.toggleLiveReview",
        "title": "Protege: Toggle Live Review"
      },
      {
        "command": "protege.startTeachFlow",
        "title": "Protege: Start guided lesson"
      },
      {
        "command": "protege.nextTeachStep",
        "title": "Protege: Next lesson step"
      },
      {
        "command": "protege.stopTeachFlow",
        "title": "Protege: Stop lesson"
      },
      {
        "command": "protege.refreshIQ",
        "title": "Protege: Refresh Code IQ"
      },
      {
        "command": "protege.scanActiveFile",
        "title": "Protege: Scan active file"
      },
      {
        "command": "protege.dismissTeachPopup",
        "title": "Protege: Dismiss teaching popup"
      },
      {
        "command": "protege.createExercise",
        "title": "Protege: Create exercise"
      },
      {
        "command": "protege.checkExercise",
        "title": "Protege: Check exercise"
      },
      {
        "command": "protege.showHint",
        "title": "Protege: Show hint"
      },
      {
        "command": "protege.applyGhost",
        "title": "Protege: Apply Ghost (Tab)"
      },
      {
        "command": "protege.explainGhost",
        "title": "Protege: Explain Ghost"
      },
      {
        "command": "protege.dismissGhost",
        "title": "Protege: Dismiss Ghost (Esc)"
      },
      {
        "command": "protege.openTeachPeek",
        "title": "Protege: Open Teach Peek"
      },
      {
        "command": "protege.toggleMaxPlanBackend",
        "title": "Protege: Max Plan — switch Qwen 7B ↔ Haiku"
      },
      {
        "command": "protege.toggleInsetPreview",
        "title": "Protege: Preview inset-style finding (experimental)"
      },
      {
        "command": "protege.tour.startCodebase",
        "title": "Protege: Tour this codebase"
      },
      {
        "command": "protege.tour.next",
        "title": "Protege: Tour — next stop"
      },
      {
        "command": "protege.tour.stop",
        "title": "Protege: Tour — stop"
      },
      {
        "command": "protege.explainBack.start",
        "title": "Protege: Explain this code back to me"
      },
      {
        "command": "protege.explainBack.stop",
        "title": "Protege: Explain-back — stop session"
      },
      {
        "command": "protege.ownership.acceptChip",
        "title": "Protege: Ownership — open review dispatcher"
      },
      {
        "command": "protege.ownership.dismissChip",
        "title": "Protege: Ownership — dismiss chip"
      },
      {
        "command": "protege.showSelectionActions",
        "title": "Protege: Show actions for selection"
      },
      {
        "command": "protege.learning.start",
        "title": "Protege: Learn to build…"
      },
      {
        "command": "protege.learning.done",
        "title": "Protege: Learning — mark current step done"
      },
      {
        "command": "protege.learning.hint",
        "title": "Protege: Learning — reveal hint"
      },
      {
        "command": "protege.learning.show",
        "title": "Protege: Learning — show me the reference"
      },
      {
        "command": "protege.learning.stop",
        "title": "Protege: Learning — end session"
      },
      {
        "command": "protege.learning.exportSession",
        "title": "Protege: Learning — export last session trace"
      },
      {
        "command": "protege.predict.fromSelection",
        "title": "Protege: Predict what this does (selection)"
      },
      {
        "command": "protege.predict.fromCursor",
        "title": "Protege: Predict what this does (cursor)"
      },
      {
        "command": "protege.predict.acceptEndOfDay",
        "title": "Protege: Predict — accept end-of-day chip"
      },
      {
        "command": "protege.predict.dismissEndOfDay",
        "title": "Protege: Predict — dismiss end-of-day chip"
      },
      {
        "command": "protege.misconceptions.showInFile",
        "title": "Protege: Show misconceptions in this file"
      },
      {
        "command": "protege.misconceptions.quizMe",
        "title": "Protege: Misconceptions — quiz me on a flag"
      },
      {
        "command": "protege.misconceptions.showFix",
        "title": "Protege: Misconceptions — show fix for a flag"
      },
      {
        "command": "protege.misconceptions.dismiss",
        "title": "Protege: Misconceptions — dismiss a flag"
      },
      {
        "command": "protege.aiBlocks.teach",
        "title": "Protege: AI block — teach me this block"
      },
      {
        "command": "protege.aiBlocks.gotIt",
        "title": "Protege: AI block — mark reviewed"
      },
      {
        "command": "protege.aiBlocks.dismiss",
        "title": "Protege: AI block — dismiss"
      },
      {
        "command": "protege.aiBlocks.tellMore",
        "title": "Protege: AI block — open deeper lesson in chat"
      },
      {
        "command": "protege.aiBlocks.dismissAllInFile",
        "title": "Protege: AI blocks — dismiss all in this file"
      }
    ],
    "configuration": {
      "title": "Protege",
      "properties": {
        "protege.autoAcceptEdits": {
          "type": "boolean",
          "default": false,
          "description": "When true, AI-proposed edits from chat are applied without a confirmation dialog. When false (recommended), every edit shows a preview diff and requires explicit acceptance."
        },
        "protege.learning.devLogging": {
          "type": "boolean",
          "default": true,
          "description": "Capture full Learning Mode session traces — raw plan JSON, every validator verdict, hint/show reveals. Dumps to the Protege Output channel and enables the Dev drawer in the Learning panel. Use `Protege: Learning — export last session trace` to save to disk. Turn off before external release to keep sessions summary-only."
        },
        "protege.explainMode": {
          "type": "string",
          "enum": [
            "text",
            "voice",
            "both"
          ],
          "default": "text",
          "description": "How Protege delivers the Ghost Lens \"Explain\" action. `text` (default) opens the sidebar with a chat reply. `voice` speaks a short explanation through Kokoro TTS while your eyes stay on the code. `both` does both at once. Modifier keys still override per-click: hold ⌘ to force voice, ⇧ to force text."
        },
        "protege.ownership.invitations": {
          "type": "string",
          "enum": [
            "off",
            "natural-breaks",
            "aggressive"
          ],
          "default": "natural-breaks",
          "description": "When Protege nudges you to review auto-inserted (vibecoded) code. `natural-breaks` (default) shows a small status-bar chip at most once per break type per day. `aggressive` drops the per-day dedupe (useful while tuning). `off` disables all ownership nudges."
        },
        "protege.ownership.autoTrackingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Track which lines of each file you typed vs. auto-inserted from AI tools. Required for the ownership score + vibecode-review invitations. Turn off to fully disable Protege's ownership tracking (your typed code is never sent to any server — this is all local)."
        },
        "protege.selectionHover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "When true, highlighting code auto-opens a small Protege action popup (Explain · Teach me · Explain back) at the selection. The ⌘K S shortcut still works even when this is off, for keyboard-first users who don't want the auto-popup."
        },
        "protege.predict.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Predict-and-Reveal: when you hit ⌘K P on a line or selection, Protege asks you to predict what the code does for a specific input, then reveals the answer with a one-line reason. The 'feels like learning' loop — enabled by default."
        },
        "protege.misconceptions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Misconception Catcher: when you accept vibecoded code, Protege scans it against a rule library for specific wrong mental models (await in .map, JSON.parse+stringify cloning, .sort mutation, etc.) and flags matches with a subtle amber line-border + hover. Pull-based — the hover only opens when you mouse over."
        },
        "protege.learning.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Learning Mode: ⌘K L prompts for a goal, then Protege generates a 3–5 step plan and you build each step. ⌘↵ marks done, validator checks, moves to next. Instead of Protege writing code for you, it coaches you through writing it yourself."
        },
        "protege.aiBlocks.enabled": {
          "type": "boolean",
          "default": true,
          "description": "AI Block Highlighter: every auto-inserted (vibecoded) region gets a subtle blue line-wash + a CodeLens '◎ <summary> · ✿ Teach me this block'. Click to open a rich hover with a short What + a One thing to know + Got it / Tell me more / Dismiss. Replaces the old comment-thread briefing with a browsable ambient artifact — review whenever you want."
        }
      }
    },
    "keybindings": [
      {
        "command": "protege.toggle",
        "key": "cmd+shift+l",
        "when": "!terminalFocus"
      },
      {
        "command": "protege.clearHighlights",
        "key": "escape",
        "when": "editorTextFocus && !editorHasSelection && !suggestWidgetVisible && !parameterHintsVisible && !inQuickOpen && !inZenMode && protege.hasHighlights"
      },
      {
        "command": "protege.applyGhost",
        "key": "tab",
        "when": "editorTextFocus && protege.ghostActive && !inlineSuggestionVisible && !suggestWidgetVisible && !parameterHintsVisible"
      },
      {
        "command": "protege.dismissGhost",
        "key": "escape",
        "when": "editorTextFocus && protege.ghostActive && !suggestWidgetVisible && !parameterHintsVisible && !inQuickOpen"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && vite build",
    "build:ext": "tsup",
    "build:webview": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/devicon-plain": "^1.2.57",
    "@iconify-json/simple-icons": "^1.2.78",
    "@iconify/react": "^6.0.2",
    "@iconify/utils": "^3.1.0",
    "@protege/types": "workspace:*",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@shikijs/transformers": "^4.0.2",
    "@shikijs/twoslash": "^4.0.2",
    "@typescript/vfs": "^1.6.4",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.8.0",
    "node-llama-cpp": "^3.18.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "simple-icons": "^16.16.0",
    "twoslash": "^0.3.8"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^5.4.0"
  }
}
