{
  "name": "@protege/extension",
  "displayName": "Protege",
  "description": "AI coding mentor that lives in your editor",
  "version": "0.0.1",
  "private": true,
  "publisher": "protege",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "protege",
          "title": "Protege",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "protege": [
        {
          "type": "webview",
          "id": "protege.launcher",
          "name": "Protege"
        }
      ]
    },
    "commands": [
      {
        "command": "protege.openInNewTab",
        "title": "Protege: Open in New Tab"
      },
      {
        "command": "protege.toggle",
        "title": "Protege: Toggle"
      },
      {
        "command": "protege.teachThis",
        "title": "Protege: Teach this"
      },
      {
        "command": "protege.teachConcept",
        "title": "Protege: Teach concept"
      },
      {
        "command": "protege.explainSelection",
        "title": "Protege: Explain selection"
      },
      {
        "command": "protege.summarizeFile",
        "title": "Protege: What does this file do?"
      },
      {
        "command": "protege.weakSpots",
        "title": "Protege: Show my weak spots"
      },
      {
        "command": "protege.quizMe",
        "title": "Protege: Quiz me"
      },
      {
        "command": "protege.toggleLiveReview",
        "title": "Protege: Toggle Live Review"
      },
      {
        "command": "protege.startTeachFlow",
        "title": "Protege: Start guided lesson"
      },
      {
        "command": "protege.nextTeachStep",
        "title": "Protege: Next lesson step"
      },
      {
        "command": "protege.stopTeachFlow",
        "title": "Protege: Stop lesson"
      },
      {
        "command": "protege.refreshIQ",
        "title": "Protege: Refresh Code IQ"
      },
      {
        "command": "protege.scanActiveFile",
        "title": "Protege: Scan active file"
      },
      {
        "command": "protege.dismissTeachPopup",
        "title": "Protege: Dismiss teaching popup"
      },
      {
        "command": "protege.createExercise",
        "title": "Protege: Create exercise"
      },
      {
        "command": "protege.checkExercise",
        "title": "Protege: Check exercise"
      },
      {
        "command": "protege.showHint",
        "title": "Protege: Show hint"
      }
    ],
    "keybindings": [
      {
        "command": "protege.toggle",
        "key": "cmd+shift+l",
        "when": "!terminalFocus"
      },
      {
        "command": "protege.teachThis",
        "key": "cmd+k t",
        "when": "editorTextFocus"
      },
      {
        "command": "protege.explainSelection",
        "key": "cmd+k e",
        "when": "editorTextFocus"
      },
      {
        "command": "protege.quizMe",
        "key": "cmd+k q",
        "when": "editorTextFocus"
      },
      {
        "command": "protege.weakSpots",
        "key": "cmd+k w",
        "when": "editorTextFocus"
      },
      {
        "command": "protege.createExercise",
        "key": "cmd+k x",
        "when": "editorTextFocus"
      },
      {
        "command": "protege.showHint",
        "key": "cmd+k h",
        "when": "editorTextFocus"
      },
      {
        "command": "protege.clearHighlights",
        "key": "escape",
        "when": "editorTextFocus && !editorHasSelection && !suggestWidgetVisible && !parameterHintsVisible && !inQuickOpen && !inZenMode && protege.hasHighlights"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && vite build",
    "build:ext": "tsup",
    "build:webview": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@protege/types": "workspace:*",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.8.0",
    "node-llama-cpp": "^3.18.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.16.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
