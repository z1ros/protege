# Template for apps/extension/.env (gitignored). Copy this file and
# fill in the values to publish the extension to Open VSX.
#
#   cp apps/extension/.env.example apps/extension/.env
#   # then edit apps/extension/.env with the real token
#
# See apps/extension/PUBLISHING.md for the full publish flow.

# Open VSX Registry personal access token. Get one at
# https://open-vsx.org/user-settings/tokens (must be on an account
# that owns the `protege` namespace).
OVSX_PAT=ovsxat_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
